<resources>
    <!-- Warm tan, matching the web app's palette (see
         category-data-app/src/styles/global.css and lib/palette.ts).
         Sits behind the drawer-cabinet foreground glyph on the adaptive
         icon. -->
    <color name="ic_launcher_background">#EDE3CD</color>
