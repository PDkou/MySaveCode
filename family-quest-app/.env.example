# Copy this file to .env (do NOT commit .env) and adjust if you ever point
# the app at a different Supabase project.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the "publishable" (anon) key. It is
# designed to be public -- it ends up in the built JS bundle regardless of
# whether it's in a committed file, and Row Level Security (see
# supabase/schema.sql) is what actually protects the data. Never put a
# service_role key in a VITE_-prefixed variable; that key must never reach
# the frontend.

VITE_SUPABASE_URL=https://jmzucjmwgryblrpjfbzm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xOWGuou_lDiiVGuVFkPC3Q_gAW4-U1P

# VAPID public key for Web Push (device push notifications for task due
# reminders). Safe to expose -- it's the "public" half of the key pair; the
# matching private key is a Supabase Edge Function secret, never here. See
# README.md "Push notifications" for how this pairs with the Edge Function.
VITE_VAPID_PUBLIC_KEY=BGCaf4UN5pv1R7tEtmoj4Zi8Czyalqh7IGRbyDRhWZ2HT4xB1DkmjK6oEB0YPzVgyAzwI1Am6VuDqoE766UiEsw
