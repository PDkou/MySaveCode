<?xml version="1.0" encoding="utf-8"?>
<!-- Backs the FileProvider declared in AndroidManifest.xml. Only exposes
     the specific cache subfolders written for sharing, nothing else in the
     app's cache or files dirs: "shares" is ShareCardRenderer.saveAndShare()'s
     share-card PNG; "exports" (v0.47) is NativeBridge.exportBackup()'s
     user-initiated backup JSON export. -->
<paths>
    <cache-path name="shares" path="shares/" />
    <cache-path name="exports" path="exports/" />
</paths>
