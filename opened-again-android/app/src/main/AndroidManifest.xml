<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- v0.24: requested from the onboarding screen's "알림 허용" button
         (NativeBridge.requestNotificationPermission()). Runtime-checked
         permission only on API 33+ (POST_NOTIFICATIONS didn't exist before
         that); harmless to declare unconditionally since the OS ignores it
         pre-33. No notification feature exists yet to actually use this
         for, see that method's own comment. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v0.47: the daily-reminder feature that finally uses POST_NOTIFICATIONS
         (ReminderScheduler/DailyReminderReceiver) is a plain repeating
         AlarmManager alarm, which the OS clears on reboot; this lets
         BootReceiver re-arm it if the user had the "일일 리마인더" setting
         toggle on. No exact-alarm permission needed since scheduling uses
         setInexactRepeating(), which requires none. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v0.36: targetSdk 36 (Android 16) readiness pass, director flagged
         that release considerations for newer Android hadn't been looked at
         at all. enableOnBackInvokedCallback opts into the predictive-back
         gesture system (default OFF pre-16, and apps that don't opt in get
         a logcat warning on 13+ and none of the system back-preview
         animation); MainActivity's existing onBackPressed() override
         keeps working unchanged, since without a registered
         OnBackInvokedCallback the platform's compatibility path still
         calls it, so this is a behavior-preserving opt-in, not a rewrite. -->
    <application android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:enableOnBackInvokedCallback="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- v0.38: backs ShareCardRenderer.saveAndShare(), which hands the OS
             share sheet a content:// Uri for a cache-only file instead of
             saving a permanent copy into the public gallery. v0.47:
             NativeBridge.exportBackup() reuses the same provider/mechanism
             for the backup-export cache file (see file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- v0.47: daily-reminder notification, see ReminderScheduler.kt.
             Neither receiver needs to be reachable from outside this app. -->
        <receiver android:name=".DailyReminderReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
