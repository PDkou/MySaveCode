# Root of the npm workspace (family-quest-app + business-quest-app, see
# package.json's "workspaces") -- node_modules is hoisted here after the
# 2026-08 app split. Doesn't affect the unrelated game/ (Godot) project.
node_modules

# hellotoday-app/ (Android, manual aapt2/d8/apksigner build, no Gradle):
# build.sh's own output, and the debug keystore it regenerates on demand.
hellotoday-app/build/
hellotoday-app/debug.keystore

# build.sh expects an Android SDK checkout as a sibling of hellotoday-app/
# (see build.sh's SDK="$ROOT/../android-sdk"). ~300MB, fetched from the
# "android-sdk-slim" GitHub Release (see .github/workflows/fetch-android-sdk.yml)
# -- never commit it here.
/android-sdk/
