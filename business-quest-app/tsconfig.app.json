{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Shared source tree -- business-quest-app has no src/ of its own
       beyond the thin entry point below; everything else (components,
       pages, lib, context, styles, locales...) is imported from the real
       family-quest-app/src tree via this alias, kept in sync with the
       matching resolve.alias in vite.config.ts. See
       src/lib/appMode.ts there for how app-mode-specific behavior branches
       off this shared tree. */
    "paths": {
      "@core/*": ["../family-quest-app/src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
