<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon. Android requires this to be a flat white
     silhouette on a transparent background (the OS renders it using only
     the alpha channel, masked to the system's own tint); a full-color
     app icon here would show up as a solid white/gray blob. Speech-bubble
     shape (tail bottom-left), matching the GPT-drafted icon concept the
     heart-in-bubble motif was simplified to a plain bubble since fine
     detail like a heart cutout disappears at the ~24dp size this actually
     renders at in the status bar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,2H4c-1.1,0 -2,0.9 -2,2v18l4,-4h14c1.1,0 2,-0.9 2,-2V4c0,-1.1 -0.9,-2 -2,-2z" />
</vector>
