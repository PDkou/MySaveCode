<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar notification icon. Android requires this to be a flat white
     silhouette on a transparent background (the OS renders it using only
     the alpha channel, masked to the system's own tint); a full-color
     app icon here would show up as a solid white/gray blob. Speech-bubble
     with a heart cut out of it (fillType=evenOdd, so the heart sub-path
     inside the bubble becomes a transparent hole), matching this app's
     brand mark (art/HelloToday-icon-512.png). A plain bubble alone was
     tried first but reads too close to KakaoTalk's own bubble-shaped icon
     sitting right next to it in the status bar on a Korean phone. -->
